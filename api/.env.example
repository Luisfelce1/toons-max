# Clave familiar compartida. Si se omite, la API funciona en modo abierto (solo para desarrollo local).
FAMILY_KEY=demo

# Conexion a MariaDB/MySQL. Puedes usar DATABASE_URL o las variables sueltas MYSQL*.
DATABASE_URL=mysql://retrotoons:retrotoons@127.0.0.1:3306/retrotoons_dev

# Alternativa a DATABASE_URL (formato que expone Railway):
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=retrotoons
# MYSQLPASSWORD=retrotoons
# MYSQLDATABASE=retrotoons_dev

# Puerto del servidor Express (Railway lo asigna automaticamente).
PORT=3000

# Origen permitido por CORS en produccion (en local se permite localhost:4200 automaticamente).
CORS_ORIGIN=

NODE_ENV=development

# YouTube Data API v3 (gratis, cuota diaria). Solo para `npm run ingesta:videos`,
# que toma episodios completos EXCLUSIVAMENTE de canales oficiales.
YOUTUBE_API_KEY=
